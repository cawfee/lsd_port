# EditorConfig -- https://editorconfig.org
# Gives CLion/VS Code/other editors the same whitespace rules as .clang-format.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{c,h}]
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
